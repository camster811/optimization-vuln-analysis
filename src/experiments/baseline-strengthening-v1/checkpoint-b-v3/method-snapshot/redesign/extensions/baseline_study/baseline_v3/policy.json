{
  "schema_version": 3,
  "method_id": "ghidra-library-contract-bounds-v3",
  "engine": "ghidra-high-pcode",
  "max_steps": 4096,
  "max_paths": 64,
  "max_call_depth": 8,
  "max_object_bytes": 4096,
  "max_string_bytes": 4096,
  "decompiler_timeout_seconds": 60,
  "process_timeout_seconds": 300,
  "control_flow": "concrete_acyclic_paths_only",
  "stack_bounds": "heuristic_nonoverlapping_recovered_arrays",
  "allocation_failure": "explore_null_and_fresh_success",
  "library_contracts": {
    "malloc": {
      "prototype": "void *malloc(unsigned long size);",
      "kind": "malloc"
    },
    "calloc": {
      "prototype": "void *calloc(unsigned long count, unsigned long size);",
      "kind": "calloc"
    },
    "free": {
      "prototype": "void free(void *ptr);",
      "kind": "free"
    },
    "memcpy": {
      "prototype": "void *memcpy(void *dest, const void *src, unsigned long count);",
      "kind": "copy"
    },
    "memmove": {
      "prototype": "void *memmove(void *dest, const void *src, unsigned long count);",
      "kind": "copy"
    },
    "memset": {
      "prototype": "void *memset(void *dest, int value, unsigned long count);",
      "kind": "set"
    },
    "strcpy": {
      "prototype": "char *strcpy(char *dest, const char *src);",
      "kind": "string_copy"
    },
    "strlen": {
      "prototype": "unsigned long strlen(const char *src);",
      "kind": "string_length"
    },
    "puts": {
      "prototype": "int puts(const char *src);",
      "kind": "read_only"
    },
    "putchar": {
      "prototype": "int putchar(int value);",
      "kind": "read_only"
    },
    "printf": {
      "prototype": "int printf(const char *format, ...);",
      "kind": "formatted_output"
    },
    "exit": {
      "prototype": "void exit(int status);",
      "kind": "terminate"
    },
    "_exit": {
      "prototype": "void _exit(int status);",
      "kind": "terminate"
    },
    "abort": {
      "prototype": "void abort(void);",
      "kind": "terminate"
    },
    "wmemset": {
      "prototype": "unsigned int *wmemset(unsigned int *dest, unsigned int value, unsigned long count);",
      "kind": "wide_set"
    },
    "wcslen": {
      "prototype": "unsigned long wcslen(const unsigned int *src);",
      "kind": "wide_length"
    },
    "wcscpy": {
      "prototype": "unsigned int *wcscpy(unsigned int *dest, const unsigned int *src);",
      "kind": "wide_copy"
    },
    "strcat": {
      "prototype": "char *strcat(char *dest, const char *src);",
      "kind": "concatenate"
    },
    "wprintf": {
      "prototype": "int wprintf(const unsigned int *format, ...);",
      "kind": "wide_output"
    }
  },
  "native_store_fallback": "constant_affine_stack_stores_only",
  "wchar_bytes": 4
}
