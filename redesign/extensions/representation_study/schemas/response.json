{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Representation-study classification response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "confidence", "evidence", "summary"],
  "properties": {
    "decision": {
      "enum": ["vulnerable_CWE-121", "vulnerable_CWE-122", "not_vulnerable", "uncertain"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[AD]:F[0-9]{4,}:L[0-9]{5,}$"}
    },
    "summary": {"type": "string", "minLength": 1}
  }
}
