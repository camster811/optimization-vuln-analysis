{
  "schema_version": 1,
  "policy_id": "entry-closure-v1",
  "bundle_schema_version": 2,
  "ghidra_version": "12.1.4",
  "language": "x86:LE:64:default",
  "compiler_spec": "gcc",
  "external_debug_information": "disabled",
  "autoload_libraries": false,
  "analysis_timeout_seconds": 120,
  "decompiler_timeout_seconds": 60,
  "process_timeout_seconds": 300,
  "max_functions": 32,
  "max_instructions": 4096,
  "max_data_bytes": 16384,
  "max_data_bytes_per_reference": 256,
  "unknown_data_window_bytes": 16,
  "max_bundle_utf8_bytes": 131072,
  "max_token_upper_bound": 65536,
  "token_accounting": "utf8_bytes_upper_bound",
  "allow_assembly_only": false,
  "unresolved_transfers": "extraction_unavailable",
  "data_policy": "direct_references_recovered_extent_or_explicit_unknown_window",
  "external_policy": "exclude_external_bodies_and_linkage_thunks",
  "ordering": "ascending_function_entry_instruction_address_transfer_site_data_address"
}
