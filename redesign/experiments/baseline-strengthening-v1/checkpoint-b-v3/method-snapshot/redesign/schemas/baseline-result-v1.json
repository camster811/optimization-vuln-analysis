{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "error_code": {
      "enum": [
        null,
        "input_unavailable",
        "runtime_failure"
      ]
    },
    "ir_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "method_id": {
      "const": "ghidra-constant-bounds-v1"
    },
    "prediction": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "enum": [
                "vulnerable_CWE-122",
                "not_vulnerable",
                "uncertain"
              ]
            },
            "evidence": {
              "items": {
                "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,15})$",
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "paths": {
              "minimum": 0,
              "type": "integer"
            },
            "reason_codes": {
              "items": {
                "enum": [
                  "heap_write_exceeds_allocation",
                  "all_selected_writes_accounted_for",
                  "unknown_stack_bound",
                  "unknown_destination",
                  "unknown_write_extent",
                  "unknown_allocation_size",
                  "unknown_string_extent",
                  "unknown_copy_source",
                  "nonlive_allocation",
                  "static_write_outside_export",
                  "static_write_not_writable",
                  "unsupported_pcode",
                  "unsupported_library_call",
                  "unsupported_output_format",
                  "argument_recovery",
                  "overlapping_memcpy",
                  "unresolved_call",
                  "unresolved_branch",
                  "recursive_call",
                  "call_depth_limit",
                  "cyclic_control_flow",
                  "incomplete_control_flow",
                  "step_limit",
                  "path_limit",
                  "entry_inside_function",
                  "unaccounted_native_write",
                  "unknown_read_address"
                ]
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "status": {
              "enum": [
                "classified",
                "abstained"
              ]
            },
            "steps": {
              "minimum": 0,
              "type": "integer"
            },
            "write_checks": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "capacity": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "evidence": {
                    "items": {
                      "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,15})$",
                      "type": "string"
                    },
                    "type": "array",
                    "uniqueItems": true
                  },
                  "offset": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "outcome": {
                    "enum": [
                      "unknown",
                      "within_bounds",
                      "exceeds_allocation",
                      "zero_extent",
                      "static_storage_write"
                    ]
                  },
                  "region": {
                    "enum": [
                      "heap",
                      "stack",
                      "static",
                      "unknown"
                    ]
                  },
                  "site": {
                    "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,15})$",
                    "type": "string"
                  },
                  "size": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "site",
                  "region",
                  "offset",
                  "size",
                  "capacity",
                  "outcome",
                  "evidence"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "decision",
            "status",
            "reason_codes",
            "evidence",
            "write_checks",
            "steps",
            "paths"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "lifted",
        "completed",
        "input_unavailable",
        "runtime_failed"
      ]
    }
  },
  "required": [
    "schema_version",
    "method_id",
    "bundle_sha256",
    "ir_sha256",
    "status",
    "prediction",
    "error_code"
  ],
  "title": "Constant bounds baseline result v1",
  "type": "object"
}
