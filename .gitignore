# Python caches and compiled extensions
__pycache__/
*.py[codz]
*.so

# Virtual environments and local credentials/configuration
.venv/
.venv-*/
venv/
env/
.env
.env.*
!.env.example
!.env.template
/.aws/
/.codex/
/.idea/
/.vscode/

# Generated build and test output
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.mypy_cache/
.ruff_cache/
*.log

# Model weights, checkpoints and backup archives stay local
/models/
/checkpoints/
*.gguf
*.safetensors
*.7z
*.zip
*.tar
*.tar.gz
*.tar.xz
*.tar.bz2
*.tgz

# Old layout; record tracked deletions rather than adding this workspace again
/redesign/
/campaigns/

# Commit the small source/pilot fixtures and navigation; keep full datasets local
/data/*
!/data/README.md
!/data/sources/
/data/sources/build/

# Commit only the accepted final report exports, not raw runs or method snapshots
/results/*
!/results/README.md
!/results/representation/
/results/representation/*
!/results/representation/analysis/
/results/representation/analysis/*
!/results/representation/analysis/agreement.csv
!/results/representation/analysis/audit.json
!/results/representation/analysis/compute.csv
!/results/representation/analysis/contrasts.csv
!/results/representation/analysis/control.csv
!/results/representation/analysis/disagreements.csv
!/results/representation/analysis/evaluation.json
!/results/representation/analysis/failed-slots.csv
!/results/representation/analysis/matched-contrasts.csv
!/results/representation/analysis/matched-pairs.csv
!/results/representation/analysis/metrics.csv
!/results/representation/analysis/observation-condition.csv
!/results/representation/analysis/stability.csv
!/results/representation/analysis/figures/
/results/representation/analysis/figures/*
!/results/representation/analysis/figures/*.png
!/results/representation/analysis/figures/*.svg

# Historical work products are local research data
/artifacts/*
!/artifacts/README.md

# Generated manuscript output
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc
