{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:representation-study:view-v1",
  "title": "Public representation view v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "representation",
    "shared"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "representation": {
      "enum": [
        "assembly",
        "decompilation",
        "combined"
      ]
    },
    "shared": {
      "$ref": "#/$defs/shared"
    },
    "assembly": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assembly_function"
      }
    },
    "decompilation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/decompilation_function"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "representation": {
          "const": "assembly"
        }
      },
      "required": [
        "assembly"
      ],
      "not": {
        "required": [
          "decompilation"
        ]
      }
    },
    {
      "properties": {
        "representation": {
          "const": "decompilation"
        }
      },
      "required": [
        "decompilation"
      ],
      "not": {
        "required": [
          "assembly"
        ]
      }
    },
    {
      "properties": {
        "representation": {
          "const": "combined"
        }
      },
      "required": [
        "assembly",
        "decompilation"
      ]
    }
  ],
  "$defs": {
    "function_id": {
      "type": "string",
      "pattern": "^F[0-9]{4,}$"
    },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "entry_address",
        "assumptions",
        "functions",
        "calls",
        "data",
        "recovery"
      ],
      "properties": {
        "architecture": {
          "$ref": "urn:representation-study:parent-bundle-v2#/properties/architecture"
        },
        "entry_address": {
          "$ref": "urn:representation-study:parent-bundle-v2#/properties/entry_address"
        },
        "assumptions": {
          "$ref": "urn:representation-study:parent-bundle-v2#/properties/assumptions"
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "entry",
              "name"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/function_id"
              },
              "entry": {
                "$ref": "urn:representation-study:parent-bundle-v2#/properties/functions/items/properties/entry"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "calls": {
          "$ref": "urn:representation-study:parent-bundle-v2#/properties/calls"
        },
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/data_window"
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "traversal",
            "data",
            "decompilation",
            "external_bodies",
            "localization",
            "omissions",
            "unresolved_transfers"
          ],
          "properties": {
            "traversal": {
              "$ref": "urn:representation-study:parent-bundle-v2#/properties/completeness/properties/traversal"
            },
            "data": {
              "$ref": "urn:representation-study:parent-bundle-v2#/properties/completeness/properties/data"
            },
            "decompilation": {
              "$ref": "urn:representation-study:parent-bundle-v2#/properties/completeness/properties/decompilation"
            },
            "external_bodies": {
              "$ref": "urn:representation-study:parent-bundle-v2#/properties/completeness/properties/external_bodies"
            },
            "localization": {
              "$ref": "urn:representation-study:parent-bundle-v2#/properties/completeness/properties/localization"
            },
            "omissions": {
              "$ref": "urn:representation-study:parent-bundle-v2#/properties/completeness/properties/omissions"
            },
            "unresolved_transfers": {
              "$ref": "urn:representation-study:parent-bundle-v2#/properties/unresolved_transfers"
            }
          }
        }
      }
    },
    "data_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "bytes",
        "writable",
        "storage",
        "references",
        "truncated",
        "window_size_bytes",
        "window_origin",
        "window_semantics"
      ],
      "properties": {
        "address": {
          "$ref": "urn:representation-study:parent-bundle-v2#/properties/data/items/properties/address"
        },
        "bytes": {
          "$ref": "urn:representation-study:parent-bundle-v2#/properties/data/items/properties/bytes"
        },
        "writable": {
          "$ref": "urn:representation-study:parent-bundle-v2#/properties/data/items/properties/writable"
        },
        "storage": {
          "$ref": "urn:representation-study:parent-bundle-v2#/properties/data/items/properties/storage"
        },
        "references": {
          "$ref": "urn:representation-study:parent-bundle-v2#/properties/data/items/properties/references"
        },
        "truncated": {
          "$ref": "urn:representation-study:parent-bundle-v2#/properties/data/items/properties/truncated"
        },
        "window_size_bytes": {
          "$ref": "urn:representation-study:parent-bundle-v2#/properties/data/items/properties/size"
        },
        "window_origin": {
          "enum": [
            "recovered_window",
            "unknown_window"
          ]
        },
        "window_semantics": {
          "const": "available_bytes_not_object_capacity"
        }
      }
    },
    "assembly_function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function_id",
        "lines"
      ],
      "properties": {
        "function_id": {
          "$ref": "#/$defs/function_id"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "address",
              "mnemonic",
              "operands"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "pattern": "^A:F[0-9]{4,}:L[0-9]{5,}$"
              },
              "address": {
                "$ref": "urn:representation-study:parent-bundle-v2#/properties/functions/items/properties/instructions/items/properties/address"
              },
              "mnemonic": {
                "$ref": "urn:representation-study:parent-bundle-v2#/properties/functions/items/properties/instructions/items/properties/mnemonic"
              },
              "operands": {
                "$ref": "urn:representation-study:parent-bundle-v2#/properties/functions/items/properties/instructions/items/properties/operands"
              }
            }
          }
        }
      }
    },
    "decompilation_function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function_id",
        "lines"
      ],
      "properties": {
        "function_id": {
          "$ref": "#/$defs/function_id"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "text"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "pattern": "^D:F[0-9]{4,}:L[0-9]{5,}$"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
